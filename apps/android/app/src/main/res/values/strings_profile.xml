    <string name="account_deletion_title">Xóa tài khoản</string>
    <string name="account_deletion_explanation">Khi xóa tài khoản, bạn sẽ bị đăng xuất khỏi mọi thiết bị và không đăng nhập lại được. Họ tên, email, số điện thoại và ảnh đại diện của bạn bị xóa khỏi hồ sơ. Bài làm của bạn được giữ ở dạng không còn gắn với bạn. Đơn hàng, thanh toán, nhật ký hệ thống và thư đã gửi được lưu theo quy định của pháp luật và thời hạn lưu trữ.</string>
    <string name="account_deletion_unusedAttemptsWarning">Bạn còn {n} lượt thi chưa dùng. Các lượt này sẽ mất và không được hoàn tiền.</string>
    <string name="account_deletion_pendingGradingWarning">Bạn có bài đang chờ chấm. Xóa tài khoản thì bạn sẽ không xem được kết quả.</string>
