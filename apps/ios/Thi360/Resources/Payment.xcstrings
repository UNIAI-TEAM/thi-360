      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One exam in this bundle has just been discontinued. No amount has been charged."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bài trong bộ vừa ngừng bán. Chưa có khoản nào bị trừ."
          }
        }
      }
    },
    "bundle.checkout.unavailableTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bundle is temporarily unavailable."
          }
