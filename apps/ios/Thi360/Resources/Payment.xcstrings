{
  "sourceLanguage": "vi",
  "strings": {
    "bundle.checkout.backToBundle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to bundle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại chi tiết bộ đề"
          }
        }
      }
    },
    "bundle.checkout.existingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For exams you already own, newly purchased attempts are added to your remaining balance. Benefits apply per grant."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đã có quyền thì lượt mua thêm cộng vào lượt đang có. Quyền lợi theo từng lần cấp."
          }
        }
      }
    },
    "bundle.checkout.grantNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once completed, all {count, plural, one {# exam in the bundle} other {# exams in the bundle}} will be granted to account {username}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi hoàn tất, toàn bộ {count, plural, other {# bài thi trong bộ}} sẽ được cấp cho tài khoản {username}."
          }
        }
      }
    },
    "bundle.checkout.itemsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included exams ({count})"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài thi trong bộ ({count})"
          }
        }
      }
    },
    "bundle.checkout.pendingExamOrder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order {orderCode} for {name} is being checked. You do not need to pay again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn {orderCode} cho bài {name} đang được kiểm tra. Bạn không cần thanh toán lại."
          }
        }
      }
    },
    "bundle.checkout.pendingExamOrderNoCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An order for {name} is being checked. You do not need to pay again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có đơn đang được kiểm tra cho bài {name}. Bạn không cần thanh toán lại."
          }
        }
      }
    },
    "bundle.checkout.refundBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exams in the bundle are granted immediately after completion and cannot be refunded once any attempt is activated."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài thi trong bộ được cấp ngay sau khi giao dịch hoàn tất và không hỗ trợ hoàn tiền sau khi đã kích hoạt lượt thi."
          }
        }
      }
    },
    "bundle.checkout.sectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected bundle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ đề đã chọn"
          }
        }
      }
    },
    "bundle.checkout.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the included exams, access rights, and receiving account before paying."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra danh sách bài thi trong bộ, quyền lợi nhận được và tài khoản nhận bài trước khi thanh toán."
          }
        }
      }
    },
    "bundle.checkout.summaryLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle summary"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt bộ đề"
          }
