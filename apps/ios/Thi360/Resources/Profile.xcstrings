{
  "sourceLanguage": "vi",
  "strings": {
    "account.deletion.acknowledge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that a deleted account cannot be recovered."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu tài khoản bị xóa sẽ không khôi phục được."
          }
        }
      }
    },
    "account.deletion.blockedAttempt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an unsubmitted exam attempt. Please submit it and come back."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang có lượt thi chưa nộp. Hãy nộp bài rồi quay lại."
          }
        }
      }
    },
    "account.deletion.blockedOrder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an order being checked. Please wait for the exam to be granted or contact support and come back."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có đơn hàng đang được kiểm tra. Hãy chờ bài thi được cấp hoặc liên hệ hỗ trợ rồi quay lại."
          }
        }
      }
    },
    "account.deletion.blockedPendingPayment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an order pending payment. Please cancel the order or wait for it to expire and come back."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có đơn hàng đang chờ thanh toán. Hãy hủy đơn hoặc chờ đơn hết hạn rồi quay lại."
          }
        }
      }
    },
    "account.deletion.confirmAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản"
          }
        }
      }
    },
    "account.deletion.confirmCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "account.deletion.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account permanently?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản vĩnh viễn?"
          }
        }
      }
    },
    "account.deletion.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you delete your account, you will be signed out of all devices and will not be able to sign in again. Your full name, email, phone number, and profile photo will be removed from your profile. Your exam submissions will be kept without being linked to you. Orders, payments, system logs, and sent emails are retained in accordance with legal requirements and retention periods."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xóa tài khoản, bạn sẽ bị đăng xuất khỏi mọi thiết bị và không đăng nhập lại được. Họ tên, email, số điện thoại và ảnh đại diện của bạn bị xóa khỏi hồ sơ. Bài làm của bạn được giữ ở dạng không còn gắn với bạn. Đơn hàng, thanh toán, nhật ký hệ thống và thư đã gửi được lưu theo quy định của pháp luật và thời hạn lưu trữ."
          }
        }
      }
    },
    "account.deletion.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete your account. Please try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xóa được tài khoản. Vui lòng thử lại."
          }
        }
      }
    },
    "account.deletion.openMyExams": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My exams"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài thi của tôi"
          }
        }
      }
    },
    "account.deletion.openMyOrders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My orders"
          }
        },
        "vi": {
          "stringUnit": {
