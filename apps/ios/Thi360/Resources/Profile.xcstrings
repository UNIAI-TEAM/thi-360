        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh lớn hơn 5 MB. Hãy chọn ảnh nhỏ hơn."
          }
        }
      }
    },
    "account.profile.avatar.errors.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to update the profile picture. Your current picture is unchanged."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cập nhật được ảnh đại diện. Ảnh hiện tại được giữ nguyên."
          }
        }
      }
    },
    "account.profile.avatar.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JPG, PNG or WEBP; up to 5 MB and 4,096 × 4,096 px. The image is cropped to a square."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JPG, PNG hoặc WEBP; tối đa 5 MB và 4.096 × 4.096 px. Ảnh được cắt vuông."
          }
        }
      }
    },
