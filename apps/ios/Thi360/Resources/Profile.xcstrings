    "account.profile.avatar.errors.DIMENSIONS_EXCEEDED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is larger than 4,096 × 4,096 px. Please choose a smaller image."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh lớn hơn 4.096 × 4.096 px. Hãy chọn ảnh nhỏ hơn."
          }
        }
      }
    },
    "account.profile.avatar.errors.INVALID_IMAGE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image cannot be read. Please choose a valid JPG, PNG or WEBP file."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được ảnh. Hãy chọn tệp JPG, PNG hoặc WEBP hợp lệ."
          }
        }
      }
    },
    "account.profile.avatar.errors.TOO_LARGE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is larger than 5 MB. Please choose a smaller image."
