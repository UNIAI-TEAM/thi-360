        }
      }
    },
    "account.deletion.pendingGradingWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an exam waiting to be graded. If you delete your account, you will not be able to view the results."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có bài đang chờ chấm. Xóa tài khoản thì bạn sẽ không xem được kết quả."
          }
        }
      }
    },
    "account.deletion.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "vi": {
