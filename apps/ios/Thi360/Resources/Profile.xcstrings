            "state": "translated",
            "value": "Xóa tài khoản"
          }
        }
      }
    },
    "account.deletion.throttled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have entered the wrong password too many times. Please try again later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã nhập sai nhiều lần. Vui lòng thử lại sau."
          }
        }
      }
    },
    "account.deletion.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản"
          }
        }
      }
    },
    "account.deletion.unusedAttemptsWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have {n} unused exam attempts left. These attempts will be lost and will not be refunded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn {n} lượt thi chưa dùng. Các lượt này sẽ mất và không được hoàn tiền."
          }
        }
      }
    },
    "account.deletion.wrongPassword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current password is incorrect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu hiện tại chưa đúng."
          }
        }
      }
    },
    "account.profile.avatar.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thi360 does not have camera access. Enable camera permission in Settings to take a profile photo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thi360 chưa được dùng máy ảnh. Bật quyền trong Cài đặt để chụp ảnh đại diện."
          }
        }
      }
    },
    "account.profile.avatar.current": {
