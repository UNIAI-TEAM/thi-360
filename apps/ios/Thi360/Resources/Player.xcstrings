        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mất kết nối trước khi máy chủ trả lời, nên chưa biết phần thi đã đóng hay chưa. Khi có mạng lại, hệ thống kiểm tra trạng thái lượt trước khi cho gửi lại."
          }
        }
      }
    },
