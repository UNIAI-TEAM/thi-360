<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>vi</string>
	<key>CFBundleDisplayName</key>
	<string>Thi360</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>vi</string>
		<string>en</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Thi360 sử dụng Face ID để mở khóa ứng dụng nhanh và an toàn.</string>
	<key>THI360_API_BASE_URL</key>
	<string>$(THI360_API_BASE_URL)</string>
	<key>THI360_ENV</key>
	<string>$(THI360_ENV)</string>
