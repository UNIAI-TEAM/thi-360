# Chép thành .env.local trong apps/web-admin. Chỉ dùng cho máy dev.

# Đích của route proxy /api/[...path] (backend Spring Boot). Bắt buộc ở production.
THI360_API_URL=http://localhost:8080

# Web học viên: nơi có trang đăng nhập (chuyển về đây khi API trả 401).
NEXT_PUBLIC_THI360_WEB_URL=http://localhost:3000

# Dữ liệu mẫu còn lại: hàng chờ chấm tự luận /grading (đợt chấm điểm). `true` dùng dữ liệu mẫu, `false` chạy nhánh
# API thật (chưa nối nên lỗi "chưa nối API"), bỏ trống thì bật khi `next dev` và tắt khi build. Menu và trang hiện
# khi người dùng có quyền hoặc cờ bật. Cờ chỉ điều khiển kho mẫu của /grading: danh mục dùng chung (môn, khối...)
# vẫn gọi `GET /content-reference` thật — dev màn /grading cần THI360_API_URL trỏ tới backend chạy được (F-02).
# NEXT_PUBLIC_THI360_GRADING_MOCK=true
