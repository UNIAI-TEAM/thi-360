# Chép thành .env.local trong apps/web-admin. Chỉ dùng cho máy dev.

# Đích của route proxy /api/[...path] (backend Spring Boot). Bắt buộc ở production.
THI360_API_URL=http://localhost:8080

# Web học viên: nơi có trang đăng nhập (chuyển về đây khi API trả 401).
NEXT_PUBLIC_THI360_WEB_URL=http://localhost:3000

# Phiên giả để xem khung khi backend chưa có GET /api/v1/me. Bị bỏ qua ở production.
# T18 (UNI-2556) gỡ biến này.
NEXT_PUBLIC_DEV_FAKE_SESSION=1
