# Chép thành .env.local trong apps/web-admin. Chỉ dùng cho máy dev.

# Đích của route proxy /api/[...path] (backend Spring Boot). Bắt buộc ở production.
THI360_API_URL=http://localhost:8080

# Web học viên: nơi có trang đăng nhập (chuyển về đây khi API trả 401).
NEXT_PUBLIC_THI360_WEB_URL=http://localhost:3000

# Chuyển giữa dữ liệu mẫu và API thật của các màn đợt 2 (plan B7). Mỗi cờ: `true` dùng dữ liệu mẫu, `false` chạy nhánh API
# thật (tới khi nối API là lỗi "chưa nối API"), bỏ trống thì bật khi `next dev` và tắt khi build. Menu và trang hiện khi
# người dùng có quyền hoặc cờ của mục bật.
# Ngân hàng câu hỏi, Nhập câu hỏi, Bài thi (PBI-03, PBI-04):
# NEXT_PUBLIC_THI360_CONTENT_MOCK=true
# Hàng chờ chấm tự luận /grading (đợt chấm điểm):
# NEXT_PUBLIC_THI360_GRADING_MOCK=true
