{
  "realm": "thi-360",
  "enabled": true,
  "displayName": "Thi 360",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 2592000,
  "passwordPolicy": "length(8) and maxLength(64) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername",
  "clients": [
    {
      "clientId": "thi360-api",
      "name": "Thi 360 backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${THI360_KC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-thi360-api",
      "enabled": true,
      "serviceAccountClientId": "thi360-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
