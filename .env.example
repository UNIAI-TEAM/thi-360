# Chép thành .env ở gốc repo. Mọi giá trị dưới đây chỉ dùng cho máy dev.
# Không commit .env; không dùng các giá trị này ở môi trường thật.

# PostgreSQL
THI360_DB_USER=thi360
THI360_DB_PASSWORD=thi360-dev-only
THI360_DB_NAME=thi360
THI360_DB_PORT=54360

# Redis
THI360_REDIS_PORT=63790

# Keycloak (bảng điều khiển: http://localhost:8360)
THI360_KC_PORT=8360
THI360_KC_ADMIN_USER=admin
THI360_KC_ADMIN_PASSWORD=admin-dev-only
THI360_KC_CLIENT_SECRET=thi360-api-dev-only

# MinIO (S3) — API và bảng điều khiển
THI360_S3_PORT=9360
THI360_S3_CONSOLE_PORT=9361
THI360_S3_ACCESS_KEY=thi360
THI360_S3_SECRET_KEY=thi360-dev-only

# Mailpit — SMTP và giao diện xem thư (http://localhost:8361)
THI360_SMTP_PORT=1360
THI360_MAIL_UI_PORT=8361

# Ứng dụng
THI360_API_PORT=8080
