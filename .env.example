# Chép thành .env ở gốc repo. Mọi giá trị dưới đây chỉ dùng cho máy dev.
# Không commit .env; không dùng các giá trị này ở môi trường thật.

# PostgreSQL
THI360_DB_USER=thi360
THI360_DB_PASSWORD=thi360-dev-only
THI360_DB_NAME=thi360
THI360_DB_PORT=54360

# Redis
THI360_REDIS_PORT=63790

# Keycloak (bảng điều khiển: http://localhost:8360)
THI360_KC_PORT=8360
THI360_KC_ADMIN_USER=admin
THI360_KC_ADMIN_PASSWORD=admin-dev-only
# Realm của ứng dụng. Trên máy chủ Keycloak thật (dùng chung nhiều dự án) realm này đã có sẵn.
THI360_KC_REALM=thi-360
THI360_KC_CLIENT_SECRET=thi360-api-dev-only
# Tài khoản nền tảng: realm và realm role
THI360_KC_PLATFORM_REALM=master
THI360_KC_PLATFORM_ROLE=PLATFORM_ADMIN

# MinIO (S3) — API và bảng điều khiển
THI360_S3_PORT=9360
THI360_S3_CONSOLE_PORT=9361
THI360_S3_ACCESS_KEY=thi360
THI360_S3_SECRET_KEY=thi360-dev-only

# Mailpit — SMTP và giao diện xem thư (http://localhost:8361)
THI360_SMTP_PORT=1360
THI360_MAIL_UI_PORT=8361
# SMTP của backend: dev gửi vào Mailpit (không xác thực, không mã hóa). Không đặt mật khẩu thật vào repo.
THI360_SMTP_HOST=localhost
THI360_SMTP_USERNAME=
THI360_SMTP_PASSWORD=
# starttls, tls hoặc none; giá trị khác làm ứng dụng không khởi động
THI360_SMTP_TLS=none
THI360_MAIL_FROM=Thi 360 <no-reply@thi360.local>

# Ứng dụng
THI360_API_PORT=8080

# Log của backend (backend/src/main/resources/logback-spring.xml)
# Mức log của mã ứng dụng: TRACE, DEBUG, INFO, WARN, ERROR
THI360_LOG_LEVEL=INFO
# Đặt DEBUG để thấy câu SQL, TRACE để thấy cả tham số
THI360_LOG_SQL=WARN
# Thư mục tệp log, chỉ dùng khi bật profile "logfile"
THI360_LOG_DIR=logs

# Kết nối của backend & web (mặc định dev)
THI360_DB_URL=jdbc:postgresql://localhost:54360/thi360
THI360_REDIS_HOST=localhost
THI360_KC_URL=http://localhost:8360
THI360_KC_CLIENT_ID=thi360-api
THI360_KC_PLATFORM_CLIENT_ID=thi360-platform
THI360_KC_PLATFORM_CLIENT_SECRET=thi360-platform-dev-only
THI360_WEB_URL=http://localhost:3000
THI360_ADMIN_URL=http://localhost:3001
THI360_COOKIE_DOMAIN=
THI360_CTX_SECRET=ctx-dev-only-change-me-32-bytes!!
THI360_S3_ENDPOINT=http://localhost:9360
THI360_S3_BUCKET=thi360-private
# Khóa AES-256 dạng base64 (32 bytes) — CHỈ DÙNG CHO DEV, bắt buộc đặt khóa riêng ở môi trường thật
THI360_FILE_ENC_KEY=dGhpMzYwLWRldi1vbmx5LWFlcy0yNTYta2V5LTAwMDA=
THI360_API_URL=http://localhost:8080

# Xác thực & proxy tin cậy (T03)
THI360_DEV_PLATFORM_PASSWORD=platform-dev-only
THI360_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
NEXT_PUBLIC_THI360_WEB_URL=http://localhost:3000
NEXT_PUBLIC_THI360_ADMIN_URL=http://localhost:3001
# Đặt =1 khi Next.js chạy sau nginx đã cấu hình `proxy_set_header X-Real-IP $remote_addr;`
THI360_TRUST_REAL_IP=0

# Tài nguyên câu hỏi BE-2b (UNI-2614): cỡ tệp theo loại, giới hạn 60 tệp/10 phút/người
# và tiền tố khóa object trong bucket riêng tư
THI360_QB_ASSET_IMAGE_MAX=5MB
THI360_QB_ASSET_ATTACHMENT_MAX=20MB
THI360_QB_ASSET_RATE_LIMIT=60
THI360_QB_ASSET_RATE_WINDOW=PT10M
THI360_QB_ASSET_KEY_PREFIX=questions/

# Pepper HMAC của mã OTP và mã đặt lại mật khẩu (UNI-2703). Không ghi giá trị vào repo.
# Môi trường thật bắt buộc đặt; không đặt thì ứng dụng không khởi động. Profile dev, test, e2e
# dùng giá trị công khai "dev-only-..." khi biến không được xuất ra môi trường.
THI360_TOKEN_PEPPER=
# Danh sách IP hoặc CIDR của máy chủ web được miễn giới hạn tần suất API công khai (cách nhau bằng
# dấu phẩy). Để trống thì không IP nào được miễn; giới hạn đăng nhập và tải tệp không bị miễn.
THI360_SECURITY_RATELIMIT_EXEMPTIPS=

# Quên và đặt lại mật khẩu (UNI-2711, TM E16). Giá trị mặc định đã đúng spec; chỉ đặt khi cần đổi.
# Giới hạn theo IP (lần mỗi phút) của /auth/password/forgot và /auth/password/reset.
THI360_FORGOT_PER_IP_LIMIT=60
THI360_RESET_PER_IP_LIMIT=60
# Hạn mã (ISO-8601), giãn cách giữa hai yêu cầu, số yêu cầu và cửa sổ trượt của một tài khoản.
THI360_PASSWORD_RESET_TTL=PT1H
THI360_PASSWORD_RESET_COOLDOWN=PT1M
THI360_PASSWORD_RESET_DAILY_LIMIT=5
THI360_PASSWORD_RESET_DAILY_WINDOW=PT24H
# Bucket ảnh đại diện (E20), riêng với THI360_S3_BUCKET. Môi trường thật phải tạo bucket này trước.
THI360_AVATAR_BUCKET=thi360-avatars
