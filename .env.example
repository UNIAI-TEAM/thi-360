# Chép thành .env ở gốc repo. Mọi giá trị dưới đây chỉ dùng cho máy dev.
# Không commit .env; không dùng các giá trị này ở môi trường thật.

# PostgreSQL
THI360_DB_USER=thi360
THI360_DB_PASSWORD=thi360-dev-only
THI360_DB_NAME=thi360
THI360_DB_PORT=54360

# Redis
THI360_REDIS_PORT=63790

# Keycloak (bảng điều khiển: http://localhost:8360)
THI360_KC_PORT=8360
THI360_KC_ADMIN_USER=admin
THI360_KC_ADMIN_PASSWORD=admin-dev-only
# Realm của ứng dụng. Trên máy chủ Keycloak thật (dùng chung nhiều dự án) realm này đã có sẵn.
THI360_KC_REALM=thi-360
THI360_KC_CLIENT_SECRET=thi360-api-dev-only
# Tài khoản nền tảng: realm và realm role
THI360_KC_PLATFORM_REALM=master
THI360_KC_PLATFORM_ROLE=PLATFORM_ADMIN

# MinIO (S3) — API và bảng điều khiển
THI360_S3_PORT=9360
THI360_S3_CONSOLE_PORT=9361
THI360_S3_ACCESS_KEY=thi360
THI360_S3_SECRET_KEY=thi360-dev-only

# Mailpit — SMTP và giao diện xem thư (http://localhost:8361)
THI360_SMTP_PORT=1360
THI360_MAIL_UI_PORT=8361

# Ứng dụng
THI360_API_PORT=8080

# Log của backend (backend/src/main/resources/logback-spring.xml)
# Mức log của mã ứng dụng: TRACE, DEBUG, INFO, WARN, ERROR
THI360_LOG_LEVEL=INFO
# Đặt DEBUG để thấy câu SQL, TRACE để thấy cả tham số
THI360_LOG_SQL=WARN
# Thư mục tệp log, chỉ dùng khi bật profile "logfile"
THI360_LOG_DIR=logs

# Kết nối của backend & web (mặc định dev)
THI360_DB_URL=jdbc:postgresql://localhost:54360/thi360
THI360_REDIS_HOST=localhost
THI360_KC_URL=http://localhost:8360
THI360_KC_CLIENT_ID=thi360-api
THI360_KC_PLATFORM_CLIENT_ID=thi360-platform
THI360_KC_PLATFORM_CLIENT_SECRET=thi360-platform-dev-only
THI360_WEB_URL=http://localhost:3000
THI360_ADMIN_URL=http://localhost:3001
THI360_COOKIE_DOMAIN=
THI360_CTX_SECRET=ctx-dev-only-change-me-32-bytes!!
THI360_S3_ENDPOINT=http://localhost:9360
THI360_S3_BUCKET=thi360-private
THI360_FILE_ENC_KEY=dGhpMzYwLWRldi1vbmx5LWFlcy0yNTYta2V5LTAwMDA=
THI360_API_URL=http://localhost:8080

# Xác thực & proxy tin cậy (T03)
THI360_DEV_PLATFORM_PASSWORD=platform-dev-only
THI360_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
